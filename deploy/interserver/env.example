# ============================================================================
# Voltflow — SERVER environment (InterServer) — EXAMPLE / PLACEHOLDERS ONLY
# ----------------------------------------------------------------------------
# Copy to /etc/voltflow/voltflow.env on the server (root-owned, chmod 600).
# NEVER commit a real key. NEVER put this in the repo with real values.
# These are used ONLY by the Node assistant server (server/index.js) — they are
# never bundled into the frontend (only VITE_* vars reach the browser, and there
# are intentionally none that carry secrets).
#
#   sudo install -m 600 /dev/null /etc/voltflow/voltflow.env
#   sudo nano /etc/voltflow/voltflow.env   # paste the lines below with real values
# ============================================================================

# Server-only secret for the optional Claude assistant. Leave unset for a
# static-only deployment — the app falls back to Project Advisor safely.
ANTHROPIC_API_KEY=your_key_here

# Node assistant server
PORT=3001
NODE_ENV=production

# Optional: override the assistant model (defaults to claude-opus-4-8)
# ASSISTANT_MODEL=claude-opus-4-8
