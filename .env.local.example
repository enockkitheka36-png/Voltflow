# Voltflow — environment variables
# Copy to .env.local (git-ignored) for local `vercel dev`, and set the same
# values in Vercel: Project Settings -> Environment Variables, or run
#   npx vercel env add ANTHROPIC_API_KEY production
#   npx vercel env add ANTHROPIC_API_KEY preview
#
# The key is read ONLY by api/assistant.js on the server. It is never bundled
# into the browser build. Never commit a real key.

ANTHROPIC_API_KEY=your_key_here

# Optional: override the assistant model (defaults to claude-opus-4-8)
# ASSISTANT_MODEL=claude-opus-4-8

# Frontend provider. Local/demo remains the default when omitted.
VITE_VOLTFLOW_PROVIDER=local-demo
# VITE_VOLTFLOW_PROVIDER=supabase
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Server-side assistant membership validation. Use only a publishable/anon key.
# Service-role credentials are prohibited and must never be exposed to the browser.
# VOLTFLOW_REQUIRE_AUTH=true
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your_publishable_key
